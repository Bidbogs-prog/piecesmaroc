{
  // Tailwind v4 uses at-rules (@theme, @apply, @custom-variant, @import "tailwindcss")
  // that VS Code's built-in CSS validator reports as "Unknown at rule". They compile
  // fine — silence the false positives.
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",

  // Tailwind class suggestions inside className strings (used by the Tailwind extension).
  "editor.quickSuggestions": {
    "strings": "on"
  }
}
